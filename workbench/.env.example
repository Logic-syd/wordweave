# Optional standalone configuration. In this repository, npm run dev also loads
# ../.env and ../.env.local; reuse the reader's LLM_* values there.
# Do not copy blank values here if you want to inherit the repository settings.
# Keep keys server-side. Never add them to web/ or commit a real .env file.
LLM_API_KEY=""
# HTTPS OpenAI-compatible API root (without /chat/completions).
# DeepSeek: https://api.deepseek.com/v1
LLM_BASE_URL=""
# Use the model ID currently offered by your provider. No model is hardcoded.
LLM_MODEL=""
# auto disables thinking only for api.deepseek.com, as in the reader.
LLM_THINKING=auto
LLM_MAX_OUTPUT_TOKENS=8192
LLM_MAX_RESPONSE_BYTES=1048576
