# Public website: no server API key or database required.
# Users configure their own provider/key at /settings; requests go directly from browsers.
# Keep false: disables owner-funded website and legacy extension AI endpoints.
SERVER_AI_ENABLED=false
DATABASE_URL=""

# Optional LEGACY private database. Existing deployments may keep their connection.
# Local example: postgresql://wordweave:wordweave_local@localhost:5432/wordweave?schema=public
# Run db:generate / db:migrate before accessing old private records.

# Optional LEGACY server AI only, disabled above. Never use NEXT_PUBLIC_ for secrets.
# The retained standalone workbench reads these too; it is not the public BYOK website.
LLM_API_KEY=""
LLM_BASE_URL=""
LLM_MODEL=""
# Legacy owner credentials (32+ random characters); public visitors do not need these.
ADMIN_ACCESS_TOKEN=""
TRIAL_ACCESS_TOKENS=""
EXTENSION_ACCESS_TOKEN=""

# Legacy server-only quotas, persisted in PostgreSQL; not browser BYOK limits.
GENERATION_DAILY_LIMIT=20
GENERATION_DAILY_CHAR_LIMIT=120000
GENERATION_GLOBAL_DAILY_LIMIT=100
GENERATION_GLOBAL_DAILY_CHAR_LIMIT=600000
GENERATION_MAX_CONCURRENT=2
# Site-wide provider request attempts per UTC day; chunks and retries each count.
# Counts persist even if the provider fails; 0 pauses generation.
GENERATION_DAILY_MODEL_CALL_LIMIT=100
LLM_CHUNK_CONCURRENCY=2
# Maximum EXTRA model attempts across a whole article, including invalid responses.
LLM_MAX_RETRIES=2
# Additional provider calls to isolate rejected technical-article paragraphs.
# Shared across chunks, includes recovery retries; 0 disables subdivision.
# Every actual call also counts toward GENERATION_DAILY_MODEL_CALL_LIMIT.
LLM_MAX_REFUSAL_CALLS=8
LLM_MAX_OUTPUT_TOKENS=8192
LLM_MAX_RESPONSE_BYTES=1048576
# auto disables thinking for api.deepseek.com; other providers keep their default.
LLM_THINKING=auto
