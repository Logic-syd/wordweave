# Local development only. Use a strong password for a remote/production database.
DATABASE_URL="postgresql://wordweave:wordweave_local@localhost:5432/wordweave?schema=public"
# All three are required for real generation. Leave empty to use the two demos.
LLM_API_KEY=""
# HTTPS OpenAI-compatible API root, typically ending in /v1.
# DeepSeek example Base URL: https://api.deepseek.com/v1 (model ID comes from its current API console)
LLM_BASE_URL=""
LLM_MODEL=""
# Optional browser extension access token; generate a random token on /extension.
# Use the same token in Railway and extension settings, never your model API key.
# At least 32 characters. Leave empty to disable extension API access.
EXTENSION_ACCESS_TOKEN=""
