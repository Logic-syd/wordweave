# Local development only. Use a strong password for a remote/production database.
DATABASE_URL="postgresql://wordweave:wordweave_local@localhost:5432/wordweave?schema=public"
# All three are required for real generation. Leave empty to use the two demos.
LLM_API_KEY=""
# HTTPS OpenAI-compatible API root, typically ending in /v1.
# DeepSeek example Base URL: https://api.deepseek.com/v1 (model ID comes from its current API console)
LLM_BASE_URL=""
LLM_MODEL=""
# One-time owner credential for NEW production deployments (32+ random characters).
# Existing TRIAL personal or EXTENSION_ACCESS_TOKEN owners need no extra configuration.
# Log in as owner, then create/revoke friend invitations at /invites without redeploying.
ADMIN_ACCESS_TOKEN=""
# Optional legacy JSON map: stable owner IDs -> random tokens (32+ characters each).
# Existing entries still work; use the website for all new friend invitations.
# Keep "personal" for existing owner data. Never commit real tokens.
TRIAL_ACCESS_TOKENS=""
# Existing owner token also works for website login; do not share it with friends.
EXTENSION_ACCESS_TOKEN=""
# Limits per UTC day, shared by website and extension, persisted in PostgreSQL.
# Failed attempts count because the model provider may already have charged them.
GENERATION_DAILY_LIMIT=20
GENERATION_DAILY_CHAR_LIMIT=120000
GENERATION_GLOBAL_DAILY_LIMIT=100
GENERATION_GLOBAL_DAILY_CHAR_LIMIT=600000
GENERATION_MAX_CONCURRENT=2
LLM_CHUNK_CONCURRENCY=2
# Maximum EXTRA model attempts across a whole article, including invalid responses.
LLM_MAX_RETRIES=2
LLM_MAX_OUTPUT_TOKENS=8192
LLM_MAX_RESPONSE_BYTES=1048576
# auto disables thinking for api.deepseek.com; other providers keep their default.
LLM_THINKING=auto
